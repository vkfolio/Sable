{
  "name": "@sable/shell",
  "version": "0.0.0",
  "private": true,
  "description": "Sable — Electron main process and window shell",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && electron .",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.53",
    "@langchain/anthropic": "^0.3.18",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.39",
    "@langchain/openai": "^0.3.16",
    "@sable/layout-engine": "workspace:*",
    "keytar": "^7.9.0",
    "node-llama-cpp": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "typescript": "^5.7.0"
  }
}
