{
  "name": "sable",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Sable — A browser where chat and pages are one workspace.",
  "license": "MIT",
  "author": "vkdev and Sable contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkfolio/Sable.git"
  },
  "homepage": "https://github.com/vkfolio/Sable#readme",
  "bugs": {
    "url": "https://github.com/vkfolio/Sable/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "spike": "pnpm --filter spike-day0 start",
    "chrome-ui:build": "pnpm --filter @sable/chrome-ui build",
    "chrome-ui:dev": "pnpm --filter @sable/chrome-ui dev",
    "chrome-ui:typecheck": "pnpm --filter @sable/chrome-ui typecheck",
    "shell:start": "pnpm --filter @sable/shell start",
    "shell:typecheck": "pnpm --filter @sable/shell typecheck",
    "shell": "pnpm chrome-ui:build && pnpm shell:start",
    "reset": "node scripts/reset-app-data.mjs",
    "shell:fresh": "node scripts/reset-app-data.mjs && pnpm shell",
    "package:win": "pnpm chrome-ui:build && pnpm --filter @sable/shell run package:win",
    "package:win:dir": "pnpm chrome-ui:build && pnpm --filter @sable/shell run package:win:dir",
    "package:mac": "pnpm chrome-ui:build && pnpm --filter @sable/shell run package:mac",
    "package:all": "pnpm chrome-ui:build && pnpm --filter @sable/shell run package:all",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test"
  }
}