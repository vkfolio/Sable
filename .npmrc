# Hoist node-llama-cpp's binary subpackages to the top of node_modules so
# electron-builder can find them via its asarUnpack glob. Without this, the
# @node-llama-cpp/<platform>-<gpu> prebuilds live only in .pnpm/ and the
# packaged app throws "no binary found" at runtime when the local model loads.
public-hoist-pattern[]=node-llama-cpp
public-hoist-pattern[]=@node-llama-cpp/*

# Same idea, defensively, for keytar (already works but cheap insurance).
public-hoist-pattern[]=keytar
