{
  "name": "sable",
  "version": "0.0.0",
  "private": true,
  "description": "Sable — A browser where chat and pages are one workspace.",
  "license": "MIT",
  "author": "vkdev and Sable contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/sable.git"
  },
  "homepage": "https://github.com/your-org/sable#readme",
  "bugs": {
    "url": "https://github.com/your-org/sable/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "spike": "pnpm --filter spike-day0 start",
    "chrome-ui:build": "pnpm --filter @sable/chrome-ui build",
    "chrome-ui:dev": "pnpm --filter @sable/chrome-ui dev",
    "chrome-ui:typecheck": "pnpm --filter @sable/chrome-ui typecheck",
    "shell:start": "pnpm --filter @sable/shell start",
    "shell:typecheck": "pnpm --filter @sable/shell typecheck",
    "shell": "pnpm chrome-ui:build && pnpm shell:start",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test"
  }
}